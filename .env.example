# Zydex Portal Configuration
NODE_ENV=production
PORT=4000

# PostgreSQL (portal database)
DATABASE_URL=postgresql://zydex:zydex_secret@127.0.0.1:5432/zydexweb

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Magnus Billing API (create in Magnus Admin > API)
# Use your server IP or 127.0.0.1 if Zydex runs on same machine — always with /mbilling
MAGNUS_URL=http://YOUR_SERVER_IP/mbilling
MAGNUS_API_KEY=your_api_key_here
MAGNUS_API_SECRET=your_api_secret_here

# Magnus MySQL (same server - for login sync & fast reads)
MAGNUS_DB_HOST=127.0.0.1
MAGNUS_DB_NAME=mbilling
MAGNUS_DB_USER=mbillingUser
MAGNUS_DB_PASS=your_magnus_db_password

# Magnus plan IDs (optional — auto-detected by name: zydex, zydexpremium)
MAGNUS_DEFAULT_PLAN_ID=1
MAGNUS_PREMIUM_PLAN_ID=2

# Crypto payments — OxaPay (https://docs.oxapay.com/)
CRYPTO_PROVIDER=oxapay
CRYPTO_API_KEY=
CRYPTO_IPN_SECRET=
CRYPTO_WEBHOOK_URL=https://yourdomain.com/api/webhooks/crypto

# Exchange rates
EXCHANGE_RATE_API=https://api.exchangerate-api.com/v4/latest/USD

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@zydex.com
# Bot posts admin alerts (new signups, deposits) to your channel/group
TELEGRAM_BOT_TOKEN=
# Chat where the bot can post (your user id, or channel id after bot is channel admin)
TELEGRAM_CHAT_ID=
# Public support link shown in portal (user-facing)
TELEGRAM_SUPPORT_URL=https://t.me/zydex_p1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Optional: single logo image for portal sidebar (create frontend/.env.local)
# VITE_BRAND_LOGO_URL=https://your-cdn.com/your-logo.jpg

# Admin bootstrap (first admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@zydex.com
