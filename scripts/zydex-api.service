[Unit]
Description=Zydex VOIP Portal API
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/zydexweb/backend
Environment=NODE_ENV=production
EnvironmentFile=-/root/zydexweb/backend/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
